PUBLIC_API_URL=http://localhost:8085/api

# Contact mail shown for GDPR requests (data access and account deletion)
PUBLIC_PRIVACY_MAIL=

# SMTP for verification and password reset mail (STARTTLS on port 587).
# Leave EMAIL_HOST empty to print codes to the backend log instead.
# Single-quote the password so $ and # are taken literally.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
