PUBLIC_API_URL=http://localhost:8085/api

# Contact mail shown for GDPR requests (data access and account deletion)
PUBLIC_PRIVACY_MAIL=

# SMTP for verification and password reset mail (implicit SSL on port 465;
# for STARTTLS use EMAIL_PORT=587 and EMAIL_USE_SSL=False).
# Leave EMAIL_HOST empty to print codes to the backend log instead.
# Single-quote the password so $ and # are taken literally.
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Registration mail links to this page with ?verification_code=...
# (e.g. https://flowback.example.com/login/create). Empty sends a bare code.
URL_USER_CREATE=
